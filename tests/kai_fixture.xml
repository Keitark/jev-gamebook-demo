<?xml version="1.0"?>
<book>
  <section id="title"><data>
    <section id="numbered" class="numbered"><data>
      <section id="sect1" class="numbered"><meta><title>1</title></meta><data>
        <p>You enter the pass. A raider blocks the road. If you have Mindblast, it may be used normally.</p>
        <combat><enemy>Pass Raider</enemy><enemy-attribute class="combatskill">16</enemy-attribute><enemy-attribute class="endurance">10</enemy-attribute></combat>
        <choice idref="sect2">If you win, turn to <link-text>2</link-text>.</choice>
        <choice idref="sect3">If you wish to evade combat, escape to <link-text>3</link-text>.</choice>
      </data></section>
      <section id="sect2" class="numbered"><meta><title>2</title></meta><data>
        <p>The road is quiet. You walk on.</p><choice idref="sect350">Continue to <link-text>350</link-text>.</choice>
      </data></section>
      <section id="sect3" class="numbered"><meta><title>3</title></meta><data>
        <p>You escape through the pines.</p><choice idref="sect2">Return to the road at <link-text>2</link-text>.</choice>
      </data></section>
      <section id="sect4" class="numbered"><meta><title>4</title></meta><data>
        <p>You fight empty-handed.</p><combat><enemy>Wolf</enemy><enemy-attribute class="combatskill">14</enemy-attribute><enemy-attribute class="endurance">6</enemy-attribute></combat>
        <choice idref="sect2">If you win, turn to <link-text>2</link-text>.</choice>
      </data></section>
      <section id="sect350" class="numbered"><meta><title>350</title></meta><data><p>You reach Holmgard.</p></data></section>
    </data></section>
  </data></section>
</book>
